// Shared VERSIONINFO block; each target defines GGG_FILE_DESCRIPTION and GGG_ORIGINAL_FILENAME.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GGG_V_MAJOR, GGG_V_MINOR, GGG_V_PATCH, 0
PRODUCTVERSION GGG_V_MAJOR, GGG_V_MINOR, GGG_V_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Git Gud Gym"
            VALUE "FileDescription", GGG_FILE_DESCRIPTION
            VALUE "FileVersion", GGG_V_STRING
            VALUE "OriginalFilename", GGG_ORIGINAL_FILENAME
            VALUE "ProductName", "Git Gud Gym"
            VALUE "ProductVersion", GGG_V_STRING
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
